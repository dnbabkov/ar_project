<sdf version="1.8">
  <world name="actor_room">

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
    </plugin>

    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>

    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.35 0.12 -0.93</direction>
    </light>

    <light name="ceiling_lamp" type="point">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 2.85 0 0 0</pose>
      <diffuse>0.32 0.30 0.27 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.6</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.58 0.58 0.58 1</ambient>
      <background>0.92 0.94 0.97 1</background>
      <shadows>true</shadows>
    </scene>

    <audio>
      <device>default</device>
    </audio>

    <wind/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-8.7 -8.6 8.2 0 0.58 0.76</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>65535</collide_bitmask>
              <ode/>
            </contact>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
      </link>
    </model>

    <model name="room_shell">
      <static>true</static>
      <link name="link">
        <visual name="floor_visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <box>
              <size>9.6 7.6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.66 0.53 0.39 1</ambient>
            <diffuse>0.66 0.53 0.39 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>

        <collision name="north_wall_collision">
          <pose>0 3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9.8 0.18 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>0 3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>9.8 0.18 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.93 0.89 1</ambient>
            <diffuse>0.95 0.93 0.89 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="west_wall_collision">
          <pose>-4.9 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 7.8 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-4.9 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 7.8 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.94 0.92 0.88 1</ambient>
            <diffuse>0.94 0.92 0.88 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="east_wall_collision">
          <pose>4.9 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 7.8 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>4.9 0 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 7.8 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.94 0.92 0.88 1</ambient>
            <diffuse>0.94 0.92 0.88 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="south_wall_left_collision">
          <pose>-3.25 -3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_wall_left_visual">
          <pose>-3.25 -3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.93 0.89 1</ambient>
            <diffuse>0.95 0.93 0.89 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="south_wall_right_collision">
          <pose>3.25 -3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 3.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="south_wall_right_visual">
          <pose>3.25 -3.9 1.5 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 3.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.93 0.89 1</ambient>
            <diffuse>0.95 0.93 0.89 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <collision name="door_lintel_collision">
          <pose>0 -3.9 2.65 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="door_lintel_visual">
          <pose>0 -3.9 2.65 0 0 0</pose>
          <geometry>
            <box>
              <size>3.3 0.18 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.93 0.89 1</ambient>
            <diffuse>0.95 0.93 0.89 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>

        <visual name="accent_panel_visual">
          <pose>0 3.8 1.45 0 0 0</pose>
          <geometry>
            <box>
              <size>3.1 0.03 1.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.74 0.83 0.82 1</ambient>
            <diffuse>0.74 0.83 0.82 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="area_rug">
      <static>true</static>
      <pose>0 1.35 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry>
            <box>
              <size>3.7 2.5 0.004</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.37 0.42 1</ambient>
            <diffuse>0.18 0.37 0.42 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>living_room_sofa</name>
      <pose>0 2.75 0 0 0 3.14159</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sofa</uri>
    </include>

    <include>
      <name>living_room_coffee_table</name>
      <pose>0 1.15 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/CoffeeTable</uri>
    </include>

    <include>
      <name>office_desk</name>
      <pose>3.35 -1.35 0 0 0 -1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office%20Desk</uri>
    </include>

    <include>
      <name>office_chair</name>
      <pose>3.35 -2.2 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office%20Chair</uri>
    </include>

    <include>
      <name>storage_cabinet</name>
      <pose>-3.95 2.95 0 0 0 1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/WhiteCabinet</uri>
    </include>

    <include>
      <name>wall_storage_unit</name>
      <pose>3.95 1.95 0 0 0 -1.5708</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/WhiteCabinet</uri>
    </include>

    <include>
      <name>corner_side_table</name>
      <pose>-3.05 -1.0 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/CoffeeTable</uri>
    </include>

    <include>
      <name>corner_wooden_chair</name>
      <pose>-2.45 -0.55 0 0 0 2.3</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/WoodenChair</uri>
    </include>

    <actor name="room_actor">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0</time>
            <pose>-1.8 0.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>4</time>
            <pose>1.6 0.3 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>5</time>
            <pose>1.6 0.3 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>8</time>
            <pose>1.6 -2.9 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>9</time>
            <pose>1.6 -2.9 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>12</time>
            <pose>-1.8 -2.9 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>13</time>
            <pose>-1.8 -2.9 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>16</time>
            <pose>-1.8 0.3 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>17</time>
            <pose>-1.8 0.3 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
